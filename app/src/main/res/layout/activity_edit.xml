<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?rtlBg">

    <!-- Шапка формы -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/formTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/add_title"
            android:textColor="?rtlText"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <ImageView
            android:id="@+id/btnDelete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_delete"
            android:contentDescription="@string/delete"
            android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/btnSaveTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save"
            android:textColor="@color/accent"
            android:textSize="15sp"
            android:textStyle="bold"
            android:padding="10dp"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <!-- Табы шагов (скрыты в упрощённом добавлении) -->
    <LinearLayout
        android:id="@+id/stepTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:layout_marginBottom="6dp">

        <TextView android:id="@+id/tab0" style="@style/StepTab" android:text="@string/step_title" />
        <TextView android:id="@+id/tab1" style="@style/StepTab" android:text="@string/step_status" />
        <TextView android:id="@+id/tab2" style="@style/StepTab" android:text="@string/step_data" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ШАГ 1: Тайтл -->
            <LinearLayout
                android:id="@+id/pageBasics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView style="@style/FieldLabel" android:text="@string/cover" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top">

                    <FrameLayout
                        android:layout_width="92dp"
                        android:layout_height="130dp">

                        <ImageView
                            android:id="@+id/coverPrev"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/cover_placeholder"
                            android:contentDescription="@string/cover" />

                        <TextView
                            android:id="@+id/coverPrevText"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textColor="#FFFFFFFF"
                            android:textStyle="bold"
                            android:textSize="24sp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <EditText
                            android:id="@+id/coverUrlInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/cover_url_hint"
                            android:textColorHint="?rtlHint"
                            android:textColor="?rtlText"
                            android:textSize="13sp"
                            android:maxLines="1"
                            android:inputType="textUri"
                            android:importantForAutofill="no"
                            android:background="@drawable/bg_field"
                            android:padding="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <TextView android:id="@+id/btnPickCover" style="@style/MiniBtn" android:text="@string/cover_pick" />
                            <TextView android:id="@+id/btnCoverColor" style="@style/MiniBtn" android:text="@string/color_cover" />
                            <TextView android:id="@+id/btnClearCover" style="@style/MiniBtn" android:text="@string/cover_clear" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView style="@style/FieldLabel" android:text="@string/field_name" />

                <EditText
                    android:id="@+id/nameInput"
                    style="@style/FieldInput"
                    android:hint="@string/field_name"
                    android:inputType="textCapSentences" />

                <TextView style="@style/FieldLabel" android:text="@string/field_author" />

                <EditText
                    android:id="@+id/authorInput"
                    style="@style/FieldInput"
                    android:hint="@string/field_author"
                    android:inputType="textPersonName|textCapSentences" />

                <TextView style="@style/FieldLabel" android:text="@string/field_description" />

                <EditText
                    android:id="@+id/descInput"
                    style="@style/FieldInput"
                    android:hint="@string/field_description"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="4"
                    android:gravity="top" />
            </LinearLayout>

            <!-- ШАГ 2: Статус -->
            <LinearLayout
                android:id="@+id/pageStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView style="@style/FieldLabel" android:text="@string/status" />
                <Spinner android:id="@+id/statusSpinner" style="@style/FieldInput" />

                <LinearLayout
                    android:id="@+id/dropBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView style="@style/FieldLabel" android:text="@string/drop_reason" />
                    <EditText
                        android:id="@+id/dropReasonInput"
                        style="@style/FieldInput"
                        android:hint="@string/drop_reason"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="2"
                        android:gravity="top" />
                </LinearLayout>

                <TextView style="@style/FieldLabel" android:text="@string/format" />
                <Spinner android:id="@+id/formatSpinner" style="@style/FieldInput" />

                <LinearLayout
                    android:id="@+id/bookmarkBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView style="@style/FieldLabel" android:text="@string/bookmark" />
                    <EditText
                        android:id="@+id/bookmarkInput"
                        style="@style/FieldInput"
                        android:hint="@string/bookmark_hint"
                        android:inputType="textCapSentences" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ratingBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView style="@style/FieldLabel" android:text="@string/rating" android:layout_width="wrap_content" />

                        <TextView
                            android:id="@+id/ratingValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?rtlText"
                            android:textSize="15sp"
                            android:layout_marginStart="8dp" />

                        <TextView
                            android:id="@+id/btnRatingReset"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/rating_reset"
                            android:textColor="@color/accent"
                            android:textSize="13sp"
                            android:padding="8dp"
                            android:layout_marginStart="8dp"
                            android:background="?attr/selectableItemBackground" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/ratingStars"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>
            </LinearLayout>

            <!-- ШАГ 3: Данные -->
            <LinearLayout
                android:id="@+id/pageData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <!-- Тома (Серия/Одиночка) -->
                <LinearLayout
                    android:id="@+id/volumesBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView style="@style/FieldLabel" android:text="@string/volumes_read" />
                    <EditText
                        android:id="@+id/volumesInput"
                        style="@style/FieldInput"
                        android:hint="@string/read_volumes_hint"
                        android:inputType="number" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/countVolumesSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/count_volumes_switch"
                        android:textColor="?rtlText"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp" />

                    <TextView style="@style/FieldLabel" android:text="@string/total_volumes_block" />
                    <EditText
                        android:id="@+id/totalVolumesInput"
                        style="@style/FieldInput"
                        android:hint="@string/optional_25"
                        android:inputType="number" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/ongoingSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ongoing_switch"
                        android:textColor="?rtlText"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/ongoingCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?rtlHint"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Главы (Веб) -->
                <LinearLayout
                    android:id="@+id/chaptersBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView style="@style/FieldLabel" android:text="@string/chapters_progress" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/chaptersReadInput"
                            style="@style/FieldInput"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="@string/read_chapters"
                            android:inputType="number" />

                        <EditText
                            android:id="@+id/totalChaptersInput"
                            style="@style/FieldInput"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:hint="@string/total_chapters"
                            android:inputType="number" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnOpenChapters"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/open_chapters_list"
                        android:textColor="@color/accent"
                        android:textSize="14sp"
                        android:padding="10dp"
                        android:background="@drawable/bg_field"
                        android:gravity="center"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- Расчёт -->
                <TextView style="@style/FieldLabel" android:text="@string/calc_block" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/calcSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/by_volumes_switch"
                    android:textColor="?rtlText"
                    android:textSize="14sp" />

                <!-- Суммарный режим -->
                <LinearLayout
                    android:id="@+id/summaryBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView style="@style/FieldLabel" android:text="@string/words_label" />
                    <EditText
                        android:id="@+id/wordsInput"
                        style="@style/FieldInput"
                        android:hint="@string/total_words_hint"
                        android:inputType="number" />
                </LinearLayout>

                <!-- Детальный режим: таблица строк -->
                <LinearLayout
                    android:id="@+id/rowsBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/btnAddRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/add_volume"
                        android:textColor="@color/accent"
                        android:textSize="14sp"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackground" />

                    <LinearLayout
                        android:id="@+id/rowsTable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/rowsSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?rtlHint"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Всего слов в тайтле (настройка) -->
                <LinearLayout
                    android:id="@+id/totalWordsBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView style="@style/FieldLabel" android:text="@string/total_words_in_title" />
                    <EditText
                        android:id="@+id/totalWordsInput"
                        style="@style/FieldInput"
                        android:hint="@string/total_words_hint"
                        android:inputType="number" />
                </LinearLayout>

                <!-- Жанры (настройка) -->
                <LinearLayout
                    android:id="@+id/genresBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView style="@style/FieldLabel" android:text="@string/genres" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/genreInput"
                            style="@style/FieldInput"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="@string/genre_add_hint"
                            android:inputType="textCapWords"
                            android:imeOptions="actionDone" />

                        <TextView
                            android:id="@+id/genreAddBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="＋"
                            android:textColor="@color/accent"
                            android:textSize="20sp"
                            android:padding="10dp"
                            android:background="?attr/selectableItemBackground" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/genreChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </ScrollView>

    <!-- «Далее» -->
    <TextView
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/next"
        android:textColor="#FF000000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="14dp"
        android:background="@color/accent" />
</LinearLayout>
